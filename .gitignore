# macOS
.DS_Store
**/.DS_Store

# Large build artifacts - never commit
*.apk
*.aab
*.ipa

# Backend - Local credentials (never commit)
backend/.env
backend/src/main/resources/application-local.properties

# Backend - Gradle build outputs
backend/build/
backend/.gradle/
backend/*.log

# Backend - Maven (not used but just in case)
backend/target/

# Node modules — anywhere in the tree. Reinstall with `npm ci`
# (package.json + package-lock.json are committed).
node_modules/

# Frontend - Expo & build output
frontend/.expo/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/visitor-website/dist/
frontend/event-manager-portal/dist/

# IDE
.vscode/
*.iml
.idea/

# Logs
*.log
